# Copy this file to .env. Never commit the resulting .env file.

# auto | gemini | openai | none. Manual screening works with none.
SCREENING_AI_PROVIDER=auto

# Gemini Developer API (simple option)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Vertex AI alternative. Set true and supply a project to use Application Default Credentials.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# OpenAI alternative
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Review inputs. Relative paths are resolved from the repository root.
SCREENING_CRITERIA_FILE=criteria.json
# SCREENING_PAPERS_CSV=papers.csv
# SCREENING_MANIFEST=data/papers_manifest.json
# SCREENING_PDF_DIR=pdfs

# Runtime settings
# SCREENING_AI_CONCURRENCY=2
# SCREENING_STORAGE_DIR=app/storage
# SCREENING_HOST=127.0.0.1
# SCREENING_PORT=8765
